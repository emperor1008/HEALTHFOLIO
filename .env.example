# ──────────────────────────────────────────────────────────────────────────────
# Healthfolio Environment Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# NEVER put real credentials in this file.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase (public — safe for browser) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Supabase (server-only — NEVER expose to browser) ────────────────────────
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI Provider ──────────────────────────────────────────────────────────────
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=qwen2.5:3b
# Chat model for Ask Healthfolio conversations (larger model for better quality)
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
AI_REQUEST_TIMEOUT_MS=120000

# ─── OCR Configuration ────────────────────────────────────────────────────────
OCR_PROVIDER=tesseract
OCR_LANGUAGES=eng
OCR_MIN_CONFIDENCE=0.70

# ─── Document Processing ──────────────────────────────────────────────────────
DOCUMENT_MAX_BYTES=10485760

# ─── Agent Configuration ──────────────────────────────────────────────────────
AGENT_MAX_STEPS=12
AGENT_MAX_RETRIES=2
EXTRACTION_CONFIDENCE_THRESHOLD=0.85

# ─── Security (server-only — NEVER expose to browser) ────────────────────────
APP_ENCRYPTION_KEY=
