# Healthfolio Environment Configuration
# Copy this file to .env.local and fill in the values

# ─── Application ───────────────────────────────────────────────────────────────
# Public URL of the application (e.g., http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Project URL from Supabase dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Anonymous/public API key from Supabase dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (server-only, NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI Provider ───────────────────────────────────────────────────────────────
# Provider name: "openai" | "anthropic" | "google" (must match adapter implementation)
AI_PROVIDER=openai
# API key for the selected AI provider (server-only)
AI_API_KEY=
# Model identifier for text/classification tasks
AI_MODEL_TEXT=gpt-4o-mini
# Model identifier for vision/OCR tasks
AI_MODEL_VISION=gpt-4o

# ─── Document Processing ───────────────────────────────────────────────────────
# Maximum file size in bytes (default: 10 MB)
DOCUMENT_MAX_BYTES=10485760

# ─── Agent Configuration ───────────────────────────────────────────────────────
# Maximum number of agent steps per run
AGENT_MAX_STEPS=12
# Maximum number of retries for failed steps
AGENT_MAX_RETRIES=2
# Confidence threshold below which extractions need user review (0-1)
EXTRACTION_CONFIDENCE_THRESHOLD=0.85

# ─── Security ──────────────────────────────────────────────────────────────────
# Encryption key for sensitive data at rest (server-only, generate a random 32-byte key)
APP_ENCRYPTION_KEY=
