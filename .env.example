# ──────────────────────────────────────────────────────────────────────────────
# Healthfolio Environment Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# NEVER put real credentials in this file.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Firebase (public — safe for browser) ─────────────────────────────────────
# Firebase Console → Project settings → Your apps → SDK setup and configuration.
# These values are public by design; safety comes from deny-by-default
# Firestore rules (firestore.rules) — never rely on these being secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase (server-only — NEVER expose to browser) ─────────────────────────
# Service-account JSON as ONE line (console → Project settings → Service
# accounts → Generate new private key, then paste the whole JSON as the value).
FIREBASE_SERVICE_ACCOUNT_KEY=

# ─── Postgres (server-only) ───────────────────────────────────────────────────
# P1-TEMP: identity bridge + medical data live in Postgres until P2/P5.
DATABASE_URL=

# ─── Supabase (public — safe for browser) ─────────────────────────────────────
# Consultation signalling (Phase 1) uses Supabase Realtime on these same
# public credentials. Leave them as placeholders and live audio/video is
# honestly unavailable (secure text still works) — no code change needed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Supabase (server-only — NEVER expose to browser) ────────────────────────
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI Provider ──────────────────────────────────────────────────────────────
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=qwen2.5:3b
# Chat model for Ask Healthfolio conversations (larger model for better quality)
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
AI_REQUEST_TIMEOUT_MS=120000

# ─── OCR Configuration ────────────────────────────────────────────────────────
OCR_PROVIDER=tesseract
OCR_LANGUAGES=eng
OCR_MIN_CONFIDENCE=0.70

# ─── Document Processing ──────────────────────────────────────────────────────
DOCUMENT_MAX_BYTES=10485760

# ─── Consultation (Phase 1, public — optional) ────────────────────────────────
# JSON array of RTCIceServer objects. Defaults to a free public STUN server
# when unset. TURN credentials (if you have any) go here at deploy time only.
NEXT_PUBLIC_ICE_SERVERS=
# Set to 1 to emit privacy-safe consultation diagnostics to the browser
# console (event names + allowlisted counters only — never SDP, never content).
NEXT_PUBLIC_DIAGNOSTICS=

# ─── Agent Configuration ──────────────────────────────────────────────────────
AGENT_MAX_STEPS=12
AGENT_MAX_RETRIES=2
EXTRACTION_CONFIDENCE_THRESHOLD=0.85

# ─── Authentication provider ───────────────────────────────────────────────────
# `database` — accounts + sessions in ordinary tables (migration 032), no
#              external identity service. scrypt password hashes, opaque
#              session tokens stored only as SHA-256, HttpOnly cookie.
# `firebase` — the existing production provider (requires the Firebase keys
#              above).
# Default: database when the Firebase server key is absent, otherwise firebase.
HF_AUTH_PROVIDER=

# ─── Temporary preview / demo mode (server-only) ──────────────────────────────
# Allows browsing every application page WITHOUT signing in, as a reserved
# demo identity over an isolated synthetic dataset.
#
# DEFAULT IS DISABLED. This is a server-side flag: never read it from a
# NEXT_PUBLIC_* variable, and never decide authorization in the browser.
#
# Local development (requires NODE_ENV=development AND a loopback/local host):
#   HF_DEMO_MODE=true
#
# Hosted preview (ALL of these are required, and every one is verified
# server-side — fail closed otherwise):
#   HF_DEMO_MODE=true
#   HF_DEPLOYMENT_ENV=preview
#   HF_PREVIEW_HOSTS=<exact comma-separated preview hostnames>
# HF_PREVIEW_HOSTS is intentionally empty here: put the real preview hostname
# in the Freebuff environment settings. The app will NOT guess it — an unset
# or non-matching allowlist keeps preview mode off.
#
# Production keeps requiring normal authentication even if HF_DEMO_MODE=true
# is set by accident: without HF_DEPLOYMENT_ENV=preview plus an allowlisted
# host, the gate stays closed.
HF_DEMO_MODE=false
HF_DEPLOYMENT_ENV=
HF_PREVIEW_HOSTS=

# Roles the reserved demo identity may hold (comma separated, validated
# against the application's role allowlist — unknown values are dropped).
# Default: patient. Add doctor / facility_admin / platform_admin only when you
# need to inspect those consoles; preview data stays isolated either way.
HF_DEMO_ROLES=patient

# ─── Local / preview database ──────────────────────────────────────────────────
# Used only when there is no valid remote database AND the deployment is local
# development or an enabled preview. PostgreSQL (PGlite) with the repository's
# real migrations — NOT a mock. Persistent by default; on a host with an
# ephemeral filesystem it falls back to an in-memory database, so preview data
# may not survive a redeploy.
HF_LOCAL_DB_DIR=.data/healthfolio

# ─── Security (server-only — NEVER expose to browser) ────────────────────────
APP_ENCRYPTION_KEY=
